# DocuHub — Global Environment Configuration
# Copy to .env at the repository root (used by Vite frontend, FastAPI backend, and Docker Compose).

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# FastAPI backend origin (e.g. http://localhost:8000).
# Leave empty to use Vite's dev proxy (/api -> http://localhost:8000) or Docker nginx proxy.
VITE_API_URL=http://localhost:8000

# ── Backend (FastAPI) ────────────────────────────────────────────────────────
APP_NAME=DocuHub
APP_ENV=development
DEBUG=true

# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# MongoDB. Use "mock://" to force the in-memory database.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=docuhub
MONGODB_FALLBACK_TO_MOCK=true

# Gemini — optional. Without a key, tags/deadlines use spaCy rules and answers are extractive.
# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vector DB & File Storage
CHROMA_PATH=./chroma_data
GRAPH_SIMILARITY_THRESHOLD=0.50
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Redis — optional (search cache + shared rate limits)
REDIS_URL=redis://localhost:6379

# google | gemini | none
TRANSLATOR=google

# Seed demo@dochub.dev / demo12345 with sample documents on backend startup
SEED_DEMO=true
